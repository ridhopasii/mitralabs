generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SiteData {
  id           Int      @id @default(1)
  json_content Json
  updated_at   DateTime @default(now()) @updatedAt
}

model SiteMessage {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  message    String
  created_at DateTime @default(now())
}

model AdminLog {
  id         Int      @id @default(autoincrement())
  action     String
  detail     String
  created_at DateTime @default(now())
}
