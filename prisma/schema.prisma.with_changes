generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model SiteConfig {
  id              Int      @id @default(1)
  logo_text       String   @default("Mitralabs")
  navbar_button   String   @default("Get Started")
  footer_desc     String   @default("Technical precision in every pixel.")
  wa_number       String   @default("6282381118520")
  business_mode   String   @default("agresif")
  wa_promo_msg    String   @default("🔥 Promo!")
  phone           String   @default("6282381118520")
  email           String   @default("ridhorobbipasi@gmail.com")
  instagram       String   @default("@mitralabs.id")
  address         String   @default("Medan, Indonesia")
  maps_url        String   @default("")
  json_content    Json?
  updated_at      DateTime @default(now()) @updatedAt
  company_npwp    String   @default("01.234.567.8-901.000")
  company_tagline String   @default("Mitra Digital Anda")
  company_website String   @default("mitralabs.id")
  linkedin_url    String   @default("linkedin.com/company/mitralabs-id")
}

model HeroSection {
  id          Int    @id @default(1)
  tagline     String @default("Mitra Digital Bisnis Mu")
  promo       String @default("Promo Aktif")
  title       String @default("Tampil Profesional Tanpa Ribet.")
  subtitle    String @default("Jasa pembuatan website profesional...")
  image_url   String @default("https://images.unsplash.com/...")
  stats_label String @default("Live Projects")
  stats_value String @default("150+")
  stats_desc  String @default("Website Berhasil Online")
}

model ServicePlan {
  id        Int      @id @default(autoincrement())
  name      String
  price     String
  tier      String
  pages     String
  duration  String
  features  String[]
  missing   String[]
  highlight Boolean  @default(false)
  order     Int      @default(0)
}

model Project {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  title        String
  category     String
  image_url    String
  description  String
  challenge    String
  solution     String
  results      String[]
  client_name  String?
  project_date String?
  live_link    String?
  tech_stack   String[]
  gallery_urls String[]
  status       String    @default("Published")
  created_at   DateTime  @default(now())
  invoices     Invoice[]
}

model Booking {
  id                  Int             @id @default(autoincrement())
  customer_name       String
  customer_email      String
  customer_phone      String
  organization_name   String?
  position            String?
  service_type        String
  plan_name           String
  project_brief       String
  desired_domain      String?
  business_industry   String?
  reference_websites  String?
  target_audience     String?
  primary_cta         String?
  competitors_list    String?
  integrations_needed String?
  biggest_expectation String?
  status              String          @default("Pending")
  total_price         Float
  scheduled_date      DateTime?
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  client_id           String?
  tracking_password   String?
  spk_url             String?
  proposal_url        String?
  client              Client?         @relation(fields: [client_id], references: [id])
  client_projects     ClientProject[]
  invoices            Invoice[]

  @@index([client_id])
}

model Invoice {
  id                   Int       @id @default(autoincrement())
  project_id           Int?
  booking_id           Int?
  invoice_number       String    @unique
  amount               Float
  status               String    @default("Unpaid")
  due_date             DateTime
  items                Json
  client_name          String?
  client_email         String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  client_address       String?
  client_company       String?
  invoice_type         String    @default("Invoice")
  project_period_end   DateTime?
  project_period_start DateTime?
  booking              Booking?  @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  project              Project?  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([booking_id])
}

model BlogPost {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  excerpt      String
  content      String
  category     String
  author       String
  image_url    String
  published_at DateTime @default(now())
}

model TeamMember {
  id        Int    @id @default(autoincrement())
  name      String
  role      String
  bio       String
  image_url String
  order     Int    @default(0)
}

model Testimonial {
  id        Int    @id @default(autoincrement())
  name      String
  role      String
  content   String
  rating    Int    @default(5)
  image_url String
}

model FAQ {
  id       Int    @id @default(autoincrement())
  question String
  answer   String
  category String
  order    Int    @default(0)
}

model SiteMessage {
  id         Int       @id @default(autoincrement())
  name       String
  email      String
  message    String
  is_read    Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model AdminLog {
  id         Int       @id @default(autoincrement())
  action     String
  detail     String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model NewsletterSub {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model UploadedImage {
  id            Int      @id @default(autoincrement())
  filename      String
  original_name String
  storage_path  String
  public_url    String
  file_size     Int
  mime_type     String
  width         Int?
  height        Int?
  uploaded_by   String?
  created_at    DateTime @default(now())

  @@index([uploaded_by])
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  full_name  String
  role       String    @default("viewer")
  avatar_url String?
  is_active  Boolean   @default(true)
  last_login DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model Client {
  id           String          @id @default(uuid())
  email        String          @unique
  full_name    String
  company_name String?
  phone        String?
  avatar_url   String?
  is_active    Boolean         @default(true)
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  bookings     Booking[]
  projects     ClientProject[]

  @@index([email])
}

model ClientProject {
  id           String          @id @default(uuid())
  client_id    String
  booking_id   Int?
  project_name String
  status       String          @default("pending")
  progress     Int             @default(0)
  description  String
  start_date   DateTime?
  deadline     DateTime?
  completed_at DateTime?
  created_at   DateTime        @default(now())
  updated_at   DateTime        @updatedAt
  booking      Booking?        @relation(fields: [booking_id], references: [id])
  client       Client          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  files        ProjectFile[]
  updates      ProjectUpdate[]

  @@index([client_id])
  @@index([booking_id])
  @@index([status])
}

model ProjectUpdate {
  id          Int           @id @default(autoincrement())
  project_id  String
  title       String
  description String
  progress    Int
  created_by  String
  is_approved Boolean       @default(false)
  approved_at DateTime?
  created_at  DateTime      @default(now())
  project     ClientProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
}

model ProjectFile {
  id          Int           @id @default(autoincrement())
  project_id  String
  filename    String
  file_url    String
  file_size   Int
  file_type   String
  uploaded_by String
  created_at  DateTime      @default(now())
  project     ClientProject @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([project_id])
}
